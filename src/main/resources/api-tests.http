POST http://localhost:8080/api/predmet
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "naziv": "Objektno orijentisano programiranje",
  "sifra": "OOP22",
  "espb": 6,
  "godinaStudija": 2,
  "semestar": 3,
  "fondCasovaPredavanja": 60,
  "fondCasovaVezbe": 60,
  "cilj": "Upoznavanje studenata sa osnovama objektno orijentisanog programiranja i primenom istih u praksi.",
  "ishodi": "Student je u stanju da razume osnovne koncepte objektno orijentisanog programiranja, kao i da primeni iste u razvoju softverskih rešenja.",
  "sadrzajPredavanja": "Upoznavanje sa osnovnim konceptima objektno orijentisanog programiranja, kao što su klase, objekti, nasleđivanje, polimorfizam i enkapsulacija. Razvoj softverskih rešenja korišćenjem objektno orijentisanih principa.",
    "sadrzajVezbi": "Praktične vežbe koje omogućavaju studentima da primene naučene koncepte u razvoju softverskih rešenja. Rad na projektima i zadacima koji zahtevaju korišćenje objektno orijentisanih principa.",
  "nacinPolaganja": "Usmeni ispit i praktični rad"
}

